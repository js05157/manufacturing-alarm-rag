PDF_PATH=data/raw/E800매뉴얼_보수편.pdf
SQLITE_PATH=storage/alarms.db
CHROMA_PATH=storage/chroma
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=
HF_HOME=.cache/huggingface
# Default: CPU Qwen3 through loopback-only llama.cpp. No API key required.
LLM_BACKEND=local
LLAMA_SERVER_PATH=C:/llama.cpp/llama-b11900-bin-win-cpu-x64/llama-server.exe
LOCAL_LLM_MODEL_PATH=C:/AI/models/qwen3-4b/Qwen3-4B-Q4_K_M.gguf
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_PORT=8080
LOCAL_LLM_MODEL=qwen3-4b
LOCAL_LLM_CONTEXT=4096
LOCAL_LLM_MAX_TOKENS=512
LOCAL_LLM_TIMEOUT=180
LOCAL_LLM_TEMPERATURE=0.2
# Legacy external provider settings are ignored when LLM_BACKEND=local.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=45
LLM_MAX_TOKENS=1800
LLM_TOKEN_PARAMETER=max_completion_tokens
TOP_K=3
MAX_DISTANCE=0.30
